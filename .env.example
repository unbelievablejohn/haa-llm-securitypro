# API 密钥配置模板
# 用法：把本文件复制为 .env，填入真实密钥。
# .env 已在 .gitignore 中屏蔽，绝不会被提交。

# ---- day5.py 使用 ----
# 智谱 GLM：   https://open.bigmodel.cn/api/paas/v4
# 通义千问：   https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：   https://api.deepseek.com/v1
HAA_API_KEY=在此填入你的密钥
HAA_BASE_URL=https://api.deepseek.com/v1
HAA_MODEL=deepseek-chat

# ---- day4_plus.py 使用（三模型评测流水线）----
# ---- day5_multi.py 使用（三模型独立判断）----
DEEPSEEK_API_KEY=在此填入 DeepSeek 密钥
ZHIPU_API_KEY=在此填入智谱密钥
QWEN_API_KEY=在此填入通义千问密钥
